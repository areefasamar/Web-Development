{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item for sale in the clothing store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Men", "Women", "Accessories", "Unisex"] },
        "stock": { "type": "integer" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "InventoryLog": {
      "title": "Inventory Log",
      "description": "Records changes in product stock",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "changeType": { "type": "string", "enum": ["restock", "sale", "correction"] },
        "quantity": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "required": ["productId", "changeType", "quantity", "timestamp"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of clothing items"
    },
    "inventory_logs": {
      "schema": "InventoryLog",
      "description": "Logs tracking inventory movements"
    }
  }
}
